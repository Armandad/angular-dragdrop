# Game Server
PORT=3000
NODE_ENV=development

# Rate Limiting
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=60000

# SoftSwiss Aggregator (optional)
SOFTSWISS_API_URL=
SOFTSWISS_API_KEY=

# GCI Aggregator (optional)
GCI_API_URL=
GCI_OPERATOR_ID=
GCI_SECRET_KEY=

# Redis (optional — for production session store)
REDIS_URL=redis://localhost:6379

# PostgreSQL (optional — for production audit logging)
DATABASE_URL=postgresql://localhost:5432/slotengine
